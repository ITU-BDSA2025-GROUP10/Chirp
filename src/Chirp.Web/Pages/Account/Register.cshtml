@page
@model Chirp.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
    Layout = "Shared/_Layout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h2>Create account</h2>
        <p class="muted">Join Chirp and start cheeping.</p>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <label class="auth-label" asp-for="Input.UserName">Username</label>
            <input asp-for="Input.UserName" class="auth-input" autocomplete="username" />
            <span asp-validation-for="Input.UserName" class="text-danger"></span>

            <label class="auth-label" asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" class="auth-input" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>

            <label class="auth-label" asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="auth-input" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>

            <label class="auth-label" asp-for="Input.ConfirmPassword">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

            <button type="submit" class="auth-primary">Create account</button>
        </form>

        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="auth-divider"><span>or</span></div>

            <form asp-page="./ExternalLogin"
                  asp-route-provider="GitHub"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">
                <button type="submit" class="auth-oauth github">
                    Sign up with GitHub
                </button>
            </form>
        }

        <p class="auth-footer">
            Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
        </p>
    </div>
</div>

