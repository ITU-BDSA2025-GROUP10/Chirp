@page
@model Chirp.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "Shared/_Layout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h2>Log in</h2>
        <p class="muted">Welcome back to Chirp.</p>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <label class="auth-label" asp-for="Input.UserName">Username</label>
            <input asp-for="Input.UserName" class="auth-input" autocomplete="username" />
            <span asp-validation-for="Input.UserName" class="text-danger"></span>

            <label class="auth-label" asp-for="Input.Password">Password</label>
            <input asp-for="Input.Password" class="auth-input" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>

            <label class="auth-checkbox">
                <input asp-for="Input.RememberMe" />
                Remember me
            </label>

            <button type="submit" class="auth-primary">Log in</button>
        </form>

        @* External login button *@
        @if (Model.ExternalLogins?.Count > 0)
        {
            <div class="auth-divider"><span>or</span></div>

            <form asp-page="./ExternalLogin"
                  asp-route-provider="GitHub"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">
                <button type="submit" class="auth-oauth github">
                    Continue with GitHub
                </button>
            </form>
        }

        <p class="auth-footer">
            No account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
        </p>
    </div>
</div>